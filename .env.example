# Copy these lines into cx_agent/.env (never commit .env)
SPRINTO_MODE=simulation          # simulation | dry_run | real_demo  (also switchable in the UI)
GEMINI_API_KEY=                  # aistudio.google.com → Get API key (starts with "AIza")
GEMINI_FREE_TIER=true
# GEMINI_MODEL=gemini-2.5-flash  # optional: pin a model to try first
HUNTER_API_KEY=                  # hunter.io → API (free: 25 searches/month)
RESEND_API_KEY=                  # resend.com → API keys; when set, emails go through Resend instead of Gmail
GMAIL_ADDRESS=you@gmail.com      # only needed without Resend
GMAIL_APP_PASSWORD=              # Google Account → Security → 2-Step Verification → App passwords
DEMO_RECIPIENT_EMAIL=you@gmail.com   # the ONLY address that ever receives mail
REAL_SENDS_ENABLED=false         # true + SPRINTO_MODE=real_demo actually sends
SENDER_NAME=Your Name, Sprinto
